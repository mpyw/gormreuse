 func ucsIsolatePlain(db *gorm.DB) {
-	ucsFindTwice(db.Model(&User{}).Where("a = 1")) // want `isolate it with \.Session`
+	ucsFindTwice(db.Model(&User{}).Where("a = 1").Session(&gorm.Session{})) // want `isolate it with \.Session`
