 // =============================================================================
 // Wrappers of values the analyzer treats as immutable (#308)
 //
 // A field read through a receiver or a parameter, a package-level variable the
 // function only reads, and a captured variable bound to an immutable value are
 // immutable where they are read. A getter or a closure that only returns such
 // a value is immutable too, so its result can be reused like the value itself.
 // =============================================================================
 
 type iwRepo struct {
 	db    *gorm.DB
 	inner iwInner
 	ptr   *iwInner
 }
 
