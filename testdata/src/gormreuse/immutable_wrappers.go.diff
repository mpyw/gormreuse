 func (r *iwRepo) InnerDB() *gorm.DB { return r.inner.db } // want InnerDB:`gormreuse immutable-return reads0\[1 0\]`
 
 func (r *iwRepo) PtrDB() *gorm.DB { return r.ptr.db } // want PtrDB:`gormreuse immutable-return reads0\[2 0\]`
 
