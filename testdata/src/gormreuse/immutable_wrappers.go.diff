 	conn := db.Session(&gorm.Session{})
 	q := func() *gorm.DB { return conn }()
 	q.Find(nil)
 	q.Count(nil) // OK: the IIFE returns conn
 }
 
 // iwClosureCapturedTxParam: tx is immutable in a Transaction callback, but no
 // body proves a parameter immutable, so get is not inferred. The tracer finds
 // no root in any of get's returns, and that makes its calls immutable.
 func iwClosureCapturedTxParam(db *gorm.DB) {
 	_ = db.Transaction(func(tx *gorm.DB) error {
 		get := func() *gorm.DB { return tx }
 		d := get()
 		d.Find(nil)
 		d.Count(nil) // OK
 		q := func() *gorm.DB { return tx }()
 		q.Find(nil)
 		q.Count(nil) // OK
 		return nil
 	})
 }
 
