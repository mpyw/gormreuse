 // --- 2. closures returning a captured immutable binding ---
 
 func iwClosureCaptured(db *gorm.DB) {
 	conn := db.Session(&gorm.Session{})
 	get := func() *gorm.DB { return conn }
 	d := get()
 	d.Find(nil)
 	d.Count(nil) // OK: get returns conn, which is immutable
 }
 
 func iwClosureCapturedField(r *iwRepo) {
 	conn := r.db
 	get := func() *gorm.DB { return conn }
 	get().Find(nil)
 	get().Count(nil) // OK
 	d := get()
 	d.Find(nil)
 	d.Count(nil) // OK
 }
 
