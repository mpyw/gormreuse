 // Regression fixtures for #174.
 //
 // On a mid-chain (clone==0) receiver, Session(&gorm.Session{}) and Debug()
 // return a handle that points at the receiver's Statement. The copy forks a
 // fresh Statement on each use, so using it never changes the original. But a
 // later in-place change to the original leaks into every later use of the
 // copy. WithContext, and Session with Context, PrepareStmt, SkipHooks or
 // NewDB, do not share: they clone the Statement (or start a new one) at once.
 //
 // Session(&gorm.Session{Initialized: true}) returns a clone==0 handle: the
 // result is itself mutable.
 
 // =============================================================================
 // SHOULD REPORT - copy used after the original changed
 // =============================================================================
 
 func sessionAliasUsedAfterBranch(db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Model(&User{}).Where("tenant = 1")
 	countQ := q.Session(&gorm.Session{})
 	q.Where("active = 1").Find(&[]User{})
 	countQ.Count(new(int64)) // want `\*gorm\.DB reused: Session/Debug copy shares the Statement of a mutable root`
 }
 
 func debugAliasUsedAfterBranch(db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Model(&User{}).Where("tenant = 1")
 	debugQ := q.Debug()
 	q.Where("active = 1").Find(&[]User{})
 	debugQ.Count(new(int64)) // want `\*gorm\.DB reused: Session/Debug copy shares the Statement of a mutable root`
 }
 
 func sessionAliasUsedAfterReassignment(db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Model(&User{}).Where("tenant = 1")
 	countQ := q.Session(&gorm.Session{})
 	q = q.Where("active = 1") // changes the shared Statement in place
 	q.Find(&[]User{})
 	countQ.Count(new(int64)) // want `\*gorm\.DB reused: Session/Debug copy shares the Statement of a mutable root`
 }
 
