 // The copy is used before the original changes: the copy forks its own
 // Statement on use, so the original is untouched.
 func sessionAliasUsedBeforeBranch(db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Where("tenant = 1")
 	countQ := q.Session(&gorm.Session{})
 	countQ.Count(new(int64)) // OK
 	q.Where("active = 1").Find(&[]User{})
 }
 
 // Session before each finisher (see e2e TestSessionBeforeFinisher).
 func sessionAliasBeforeEachFinisher(db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Where("tenant = 1")
 	q.Session(&gorm.Session{}).Count(new(int64))
 	q.Session(&gorm.Session{}).Find(&[]User{}) // OK
 	q.Debug().Find(&[]User{})                  // OK
 }
 
 // The copy can branch freely while the original is unchanged.
 func sessionAliasBranchesFreely(db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Where("tenant = 1")
 	s := q.Session(&gorm.Session{})
 	s.Where("a").Find(&[]User{})
 	s.Where("b").Find(&[]User{}) // OK
 	s.Count(new(int64))          // OK
 }
 
 // WithContext clones the Statement at call time.
 func withContextSnapshotIsSafe(ctx context.Context, db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Where("tenant = 1")
 	ctxQ := q.WithContext(ctx)
 	q.Where("active = 1").Find(&[]User{})
 	ctxQ.Count(new(int64)) // OK
 }
 
 // Session with Context, PrepareStmt, SkipHooks or NewDB does not share.
 func sessionIsolatingConfigsAreSafe(ctx context.Context, db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Where("tenant = 1")
 	a := q.Session(&gorm.Session{Context: ctx})
 	b := q.Session(&gorm.Session{PrepareStmt: true})
 	c := q.Session(&gorm.Session{SkipHooks: true})
 	d := q.Session(&gorm.Session{NewDB: true})
 	q.Where("active = 1").Find(&[]User{})
 	a.Count(new(int64)) // OK
 	b.Count(new(int64)) // OK
 	c.Count(new(int64)) // OK
 	d.Count(new(int64)) // OK
 }
 
 // A copy of an immutable value never shares a mutable Statement.
 func sessionAliasOfImmutableIsSafe(db *gorm.DB) {
 	base := db.Session(&gorm.Session{})
 	s := base.Session(&gorm.Session{})
 	base.Where("active = 1").Find(&[]User{})
 	base.Where("x").Find(&[]User{})
 	s.Count(new(int64)) // OK
 }
 
 // Initialized snapshots the Statement, so the original is not shared.
 func sessionInitializedSnapshotIsSafe(db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Where("tenant = 1")
 	init := q.Session(&gorm.Session{Initialized: true})
 	q.Where("active = 1").Find(&[]User{})
 	init.Count(new(int64)) // OK: first branch of init
 }
 
 // Initialized with a known false value keeps the result immutable.
 func sessionInitializedFalseIsImmutable(db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Where("x").Session(&gorm.Session{Initialized: false})
 	q.Where("a").Find(&[]User{})
 	q.Where("b").Find(&[]User{}) // OK
 }
 
 // A copy of a value that may hold either of two roots reads the Statement of
 // each, whichever edge the merge lists first (#341).
 func sessionAliasOfMergeSecondEdge(a, b *gorm.DB, c bool) {
 	src := a
 	if c {
 		src = b
 	}
 	cp := src.Session(&gorm.Session{})
 	b.Where("x").Find(&[]User{})
 	cp.Find(&[]User{}) // want `\*gorm\.DB reused: Session/Debug copy shares the Statement of a mutable root`
 }
 
 // The same with the edges swapped, which was already reported.
 func sessionAliasOfMergeFirstEdge(a, b *gorm.DB, c bool) {
 	src := b
 	if c {
 		src = a
 	}
 	cp := src.Session(&gorm.Session{})
 	b.Where("x").Find(&[]User{})
 	cp.Find(&[]User{}) // want `\*gorm\.DB reused: Session/Debug copy shares the Statement of a mutable root`
 }
 
 // A subquery that may hold either of two roots is read for each (#341).
 func subqueryOfMergeSecondEdge(db, a, b *gorm.DB, c bool) {
 	sub := a
 	if c {
 		sub = b
 	}
 	x := db.Session(&gorm.Session{}).Where("id IN (?)", sub)
 	b.Where("age > 1").Find(&[]User{})
 	x.Find(&[]User{}) // want `\*gorm\.DB reused: mutable root passed as a query argument`
 }
 
 // A merge that may also hold an immutable value: the copy reads the Statement
 // of the mutable root only (#341).
 func sessionAliasOfMergeWithImmutable(db, b *gorm.DB, c bool) {
 	src := b
 	if c {
 		src = db.Session(&gorm.Session{})
 	}
 	cp := src.Session(&gorm.Session{})
 	b.Where("x").Find(&[]User{})
 	cp.Find(&[]User{}) // want `\*gorm\.DB reused: Session/Debug copy shares the Statement of a mutable root`
 }
