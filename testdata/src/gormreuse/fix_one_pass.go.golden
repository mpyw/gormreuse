package internal

import "gorm.io/gorm"

// Issue #247: fixes that needed a second -fix pass, or hid a reuse.

// onePassCapturedMerge: q is captured, so SSA keeps it in memory with no Phi.
// Each store gets a Session, not only the first, which the reads resolve to.
func onePassCapturedMerge(db *gorm.DB, c bool) {
	var q *gorm.DB
	if c {
		q = db.Where("a").Session(&gorm.Session{})
	} else {
		q = db.Where("b").Session(&gorm.Session{})
	}
	go func() {
		q.Find(nil)
		q.Count(nil) // want `\*gorm\.DB reused: second branch from mutable root`
	}()
}

// onePassCapturedMergeBefore: f's only use is the call, so the read in the
// closure sees the store that reaches the call, "a" (#251). Each read outside
// sees the store that reaches it, so the last read is the first branch of "b"
// and only "a" gets a Session.
func onePassCapturedMergeBefore(db, other *gorm.DB) {
	q := db.Where("a").Session(&gorm.Session{})
	f := func() { q.Find(nil) }
	f()
	q.Count(nil) // want `\*gorm\.DB reused: second branch from mutable root`
	q = other.Where("b")
	q.Find(nil)
}

// onePassMaskedArgument: q.Find both reuses q and reads r, which r.Find
// changed. Both are reported, so the fix of q does not uncover the second.
func onePassMaskedArgument(db, other *gorm.DB) {
	q := db.Where("x")
	r := other.Where("y")
	q = q.Where(r).Session(&gorm.Session{})
	q.Count(nil)
	r.Find(nil)
	q.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root` `\*gorm\.DB reused: mutable root passed as a query argument`
}

// onePassForPost: the post statement runs after the body, although it comes
// first by position. The fix orders the uses of a block as it runs them, so
// the root, which q.Find reads first, gets a Session with the reassignment of
// q.Where("a") in one pass (#247).
func onePassForPost(db *gorm.DB) {
	q := db.Where("x").Session(&gorm.Session{})
	for i := 0; i < 2; q = q.Where("a").Session(&gorm.Session{}) { // want `\*gorm\.DB reused: second branch from mutable root`
		q.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
		i++
	}
}
