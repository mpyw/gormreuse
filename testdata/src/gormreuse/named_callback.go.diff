 func namedCallbackUseMethods(db *gorm.DB, r namedCallbackRepo) {
 	db = db.Session(&gorm.Session{})
 	_ = db.Transaction(r.txOnly)
 	_ = db.Transaction(r.txAndDirect)
 	_ = r.txAndDirect(db.Where("x"))
 	_ = db.Transaction(r.txAndExpr)
 	_ = namedCallbackRepo.txAndExpr(r, db.Where("x"))
 	_ = db.Transaction(r.txAndIface)
 	var i namedCallbackIface = r
 	_ = i.txAndIface(db.Where("x"))
 	_ = db.Transaction(r.TxExported)
 }
 
