 // --- A function literal held in a variable and also called ---
 
 func namedCallbackLiteralTwice(db *gorm.DB) {
 	cb := func(q *gorm.DB) error {
 		q.Find(nil)
 		q.Count(nil) // want `\*gorm\.DB reused: second branch from mutable root`
 		return nil
 	}
 	_ = db.Transaction(cb)
