 package internal
 
 import "gorm.io/gorm"
 
 // =============================================================================
 // Named callbacks of Transaction / FindInBatches / immutable-input (#191)
 //
 // A function's *gorm.DB parameter is exempt only when every reference to the
 // function in the package hands it to a callback position that receives a
 // fresh value. A direct call, a stored or captured reference, an interface
 // call that may reach a method, or an exported name (callable from another
 // package, #195) makes the parameter an ordinary mutable root again.
 // =============================================================================
 
 // --- Only passed as a callback: still exempt ---
 
 func namedCallbackTxOnly(tx *gorm.DB) error {
 	tx.Find(nil)
 	tx.Count(nil) // OK: every reference is a Transaction callback
 	return nil
 }
 
 func namedCallbackBatchOnly(tx *gorm.DB, _ int) error {
 	tx.Find(nil)
 	tx.Count(nil) // OK: every reference is a FindInBatches callback
 	return nil
 }
 
 func namedCallbackUseOnly(db *gorm.DB) {
 	db = db.Session(&gorm.Session{})
 	_ = db.Transaction(namedCallbackTxOnly)
 	_ = db.Transaction(namedCallbackTxOnly)
 	_ = db.FindInBatches(&[]int{}, 10, namedCallbackBatchOnly)
 	_ = db.Transaction(func(tx *gorm.DB) error {
 		return tx.Transaction(namedCallbackTxOnly) // nested: still a callback
 	})
 	defer db.Transaction(namedCallbackTxOnly)
 }
 
 // --- Passed as a callback AND called directly (the issue's repro) ---
 
+//gormreuse:immutable-param
 func namedCallbackTxAndDirect(q *gorm.DB) error {
 	q.Find(nil)
 	q.Count(nil) // want `\*gorm\.DB reused: second branch from mutable root`
 	return nil
 }
 
 func namedCallbackUseTxAndDirect(db *gorm.DB) {
 	_ = db.Transaction(namedCallbackTxAndDirect)
 }
 
 func namedCallbackCallDirect(db *gorm.DB) {
 	db = db.Session(&gorm.Session{})
 	_ = namedCallbackTxAndDirect(db.Where("x"))
 }
 
