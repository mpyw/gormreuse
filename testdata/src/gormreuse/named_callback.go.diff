 // A capturing literal is a MakeClosure: the same rule applies to its uses.
 func namedCallbackClosureTwice(db *gorm.DB, n int) {
 	cb := func(q *gorm.DB) error {
 		q.Where("n = ?", n).Find(nil)
 		q.Count(nil) // want `\*gorm\.DB reused: second branch from mutable root`
 		return nil
 	}
 	_ = db.Transaction(cb)
 	_ = cb(db.Where("x"))
 }
 
 func namedCallbackClosureOnly(db *gorm.DB, n int) {
 	cb := func(q *gorm.DB) error {
 		q.Where("n = ?", n).Find(nil)
 		q.Count(nil) // OK: only handed to Transaction
 		return nil
 	}
 	_ = db.Transaction(cb)
 }
 
