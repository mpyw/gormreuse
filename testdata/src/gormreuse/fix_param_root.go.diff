 // FixParamDiscarded changes its parameter in place with a discarded
 // statement, which the caller's value also gets. The function returns
 // nothing that could carry the change back, so reassigning the statement
 // would drop it for the caller, and no fix is offered (#243).
 func FixParamDiscarded(tx *gorm.DB) {
 	tx.Where("a")
 	tx.Find(nil)  // want `\*gorm\.DB reused: second branch from mutable root`
 	tx.Count(nil) // want `\*gorm\.DB reused: second branch from mutable root`
 }
 
 // FixParamAlias reuses its parameter through an alias. A Session at the top
 // of the body covers the alias too.
 func FixParamAlias(tx *gorm.DB) {
+	tx = tx.Session(&gorm.Session{})
 	r := tx
 	r.Where("a").Find(nil)
 	tx.Where("b").Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
 }
 
 // ===== NO FIX =====
 
 // fixParamScope has the shape of a Scopes callback and is stored in a slice,
 // so it may be one. immutable-param would hide the reuse, and a Session that
 // a Scopes callback returns leaks gorm's transaction (go-gorm/gorm#7592).
 // The fix does not tell the results apart, so it offers none.
 func fixParamScope(tx *gorm.DB) *gorm.DB {
 	tx.Where("a").Find(nil)
 	return tx.Where("b") // want `\*gorm\.DB reused: second branch from mutable root`
 }
 
 var fixParamScopes = []func(*gorm.DB) *gorm.DB{fixParamScope}
 
