 // fixPhiSessionMidChain: Session before a further chain call is mutable, so
 // that edge needs a Session too.
 //
 //gormreuse:immutable-param
 func fixPhiSessionMidChain(db *gorm.DB, c bool) {
-	q := db.Where("x")
+	q := db.Where("x").Session(&gorm.Session{})
 	if c {
-		q = db.Session(&gorm.Session{}).Where("y")
+		q = db.Session(&gorm.Session{}).Where("y").Session(&gorm.Session{})
 	}
 	q.Find(nil)
 	q.Count(nil) // want `\*gorm\.DB reused: second branch from mutable root`
 }
 
