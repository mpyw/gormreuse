 	tx.Raw("SELECT count(*) FROM users").Scan(&n)
 	return n
 }
 
 func hoSessionCount(tx *gorm.DB) int64 {
 	var n int64
 	tx.Session(&gorm.Session{}).Count(&n)
 	return n
 }
 
 func hoUnused(tx *gorm.DB) {}
 
