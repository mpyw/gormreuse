 func hoDeleteByID(db *gorm.DB, id int) error {
 	return db.Where("id = ?", id).Delete(&User{}).Error
 }
 
 func hoGroupName(tx *gorm.DB, id int) (string, error) {
 	var name string
 	err := tx.Model(&User{}).Where("id = ?", id).Select("name").Find(&name).Error
 	return name, err
 }
 
 func hoRawCount(tx *gorm.DB) int64 {
