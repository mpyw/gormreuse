 // ===== FIX: a recursive call of the parameter's own function =====
 
 type hoMenu struct {
 	ID       uint
 	Children []hoMenu
 }
 
 // hoCreateMenus calls itself with tx. The body Session rebinds tx in every
 // call, so the callee changes only its own copy.
 func hoCreateMenus(tx *gorm.DB, menus []hoMenu) error {
+	tx = tx.Session(&gorm.Session{})
 	for i := range menus {
 		if err := tx.Create(&menus[i]).Error; err != nil { // want `\*gorm\.DB reused: second branch from mutable root`
 			return err
 		}
 		if err := hoCreateMenus(tx, menus[i].Children); err != nil { // want `\*gorm\.DB reused: second branch from mutable root`
 			return err
 		}
 	}
 	return nil
 }
 
