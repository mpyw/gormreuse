 // hoRecursesWithDiscarded changes tx in place before it calls itself, so
 // its callers may rely on the change.
 func hoRecursesWithDiscarded(tx *gorm.DB, n int) {
 	tx.Where("a = 1")
 	if n > 0 {
 		hoRecursesWithDiscarded(tx, n-1) // want `\*gorm\.DB reused: second branch from mutable root`
 	}
 	tx.Find(&[]User{}) // want `\*gorm\.DB reused: second branch from mutable root`
 }
 
 // hoSwaps passes its parameters to each other's position. b is handed on,
 // not only queried, so a's change through it is not ruled out.
 func hoSwaps(a, b *gorm.DB, n int) {
 	a.Find(&[]User{})
 	if n > 0 {
 		hoSwaps(b, a, n-1) // want `\*gorm\.DB reused: second branch from mutable root`
 	}
 	a.Count(new(int64)) // want `\*gorm\.DB reused: second branch from mutable root`
 }
