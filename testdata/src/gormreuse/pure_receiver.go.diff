 func prReturnsDBCopy(db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Where("x")
 	_ = prRepo{db: q}.copyDB(nil)
 	q.Find(nil)
 }
 
 // prReturnsSelf: the pure method returns a copy of its receiver.
 func prReturnsSelf(db *gorm.DB) {
 	q := db.Session(&gorm.Session{}).Where("x")
 	_ = prRepo{db: q}.self(nil)
 	q.Find(nil)
