package internal

import (
	"context"
	"iter"
	"maps"
	"slices"

	"gorm.io/gorm"
)

// =============================================================================
// RANGE-OVER-FUNC LOOPS (#177)
//
// SSA compiles the body of `for v := range seq` (Go 1.23+) into a synthetic
// "range-over-func yield" closure that the iterator calls once per element.
// The closure's own CFG has no back-edge, so the body must be treated as a
// loop as a whole: a mutable root defined outside the loop and used inside
// is reused on every iteration, exactly as with a plain `for range` over a
// slice.
// =============================================================================

// =============================================================================
// SHOULD REPORT
// =============================================================================

// rangeFuncSlicesValues: slices.Values iterator.
func rangeFuncSlicesValues(db *gorm.DB, xs []int) {
	q := db.Where("x").Session(&gorm.Session{})
	for v := range slices.Values(xs) {
		q.Where("v = ?", v).Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
	}
}

// rangeFuncMapsKeys: maps.Keys iterator.
func rangeFuncMapsKeys(db *gorm.DB, m map[string]int) {
	q := db.Where("x").Session(&gorm.Session{})
	for k := range maps.Keys(m) {
		q.Where("k = ?", k).Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
	}
}

// rangeFuncSeqParam: a user iter.Seq parameter.
func rangeFuncSeqParam(db *gorm.DB, seq iter.Seq[int]) {
	q := db.Where("x").Session(&gorm.Session{})
	for v := range seq {
		q.Where("v = ?", v).Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
	}
}

// rangeFuncSeq2Param: a user iter.Seq2 parameter.
func rangeFuncSeq2Param(db *gorm.DB, seq iter.Seq2[int, string]) {
	q := db.Where("x").Session(&gorm.Session{})
	for k, v := range seq {
		q.Where("k = ? AND v = ?", k, v).Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
	}
}

// rangeFuncParamRoot: a bare *gorm.DB parameter is a mutable root, so
// deriving from it on every iteration is reuse, as in a plain loop.
//gormreuse:immutable-param
func rangeFuncParamRoot(db *gorm.DB, seq iter.Seq[int]) {
	for v := range seq {
		db.Where("v = ?", v).Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
	}
}

// rangeFuncNested: a root from outside both loops, used in the inner body.
func rangeFuncNested(db *gorm.DB, outer, inner iter.Seq[int]) {
	q := db.Where("x").Session(&gorm.Session{})
	for a := range outer {
		for b := range inner {
			q.Where("a = ? AND b = ?", a, b).Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
		}
	}
}

// rangeFuncNestedOuterBodyRoot: a root defined in the outer body is reused on
// every iteration of the inner loop.
func rangeFuncNestedOuterBodyRoot(db *gorm.DB, outer, inner iter.Seq[int]) {
	base := db.Session(&gorm.Session{})
	for a := range outer {
		q := base.Where("a = ?", a).Session(&gorm.Session{})
		for b := range inner {
			q.Where("b = ?", b).Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
		}
	}
}

// rangeFuncBreak: break does not make the body run only once.
func rangeFuncBreak(db *gorm.DB, seq iter.Seq[int]) {
	q := db.Where("x").Session(&gorm.Session{})
	for v := range seq {
		if v > 10 {
			break
		}
		q.Where("v = ?", v).Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
	}
}

// rangeFuncReturn: return inside the body exits the loop, but earlier
// iterations have already used q.
func rangeFuncReturn(db *gorm.DB, seq iter.Seq[int]) error {
	q := db.Where("x").Session(&gorm.Session{})
	for v := range seq {
		if err := q.Where("v = ?", v).Find(nil).Error; err != nil { // want `\*gorm\.DB reused: second branch from mutable root`
			return err
		}
	}
	return nil
}

// rangeFuncUseAfterLoop: a use after the loop is still a second branch.
func rangeFuncUseAfterLoop(db *gorm.DB, seq iter.Seq[int]) {
	q := db.Where("x").Session(&gorm.Session{})
	for v := range seq {
		q.Where("v = ?", v).Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
	}
	q.Count(nil) // want `\*gorm\.DB reused: second branch from mutable root`
}

// rangeFuncStoreOtherVar: storing the chain into another captured variable
// is not a self-update, so each iteration branches q again.
func rangeFuncStoreOtherVar(db *gorm.DB, seq iter.Seq[int]) {
	q := db.Where("x").Session(&gorm.Session{})
	var last *gorm.DB
	for v := range seq {
		last = q.Where("v = ?", v) // want `\*gorm\.DB reused: second branch from mutable root`
	}
	last.Find(nil)
}

// =============================================================================
// SHOULD NOT REPORT
// =============================================================================

// rangeFuncRootInsideBody: a root defined inside the body is fresh on every
// iteration. It is built from an immutable base, since a bare *gorm.DB
// parameter is itself a mutable root.
func rangeFuncRootInsideBody(db *gorm.DB, seq iter.Seq[int]) {
	base := db.Session(&gorm.Session{})
	for v := range seq {
		q := base.Where("v = ?", v)
		q.Find(nil)
	}
}

// rangeFuncRootInsideNestedBody: a root defined in the inner body is fresh on
// every inner iteration.
func rangeFuncRootInsideNestedBody(db *gorm.DB, outer, inner iter.Seq[int]) {
	base := db.Session(&gorm.Session{})
	for a := range outer {
		for b := range inner {
			q := base.Where("a = ? AND b = ?", a, b)
			q.Find(nil)
		}
	}
}

// rangeFuncImmutableRoot: an immutable root may be reused freely.
func rangeFuncImmutableRoot(db *gorm.DB, seq iter.Seq[int]) {
	q := db.Where("x").Session(&gorm.Session{})
	for v := range seq {
		q.Where("v = ?", v).Find(nil)
	}
}

// rangeFuncReassign: reassigning the outer variable each iteration builds a
// single chain, like `q = q.Where(...)` in a plain loop.
func rangeFuncReassign(db *gorm.DB, seq iter.Seq[int]) {
	q := db.Where("x")
	for v := range seq {
		q = q.Where("v = ?", v)
		q = q.Where("a").Where("b = ?", v)
	}
	q.Find(nil)
}

// rangeFuncReassignNested: the self-update also holds from a nested body,
// whose captured q is itself a captured variable of the outer body.
func rangeFuncReassignNested(db *gorm.DB, outer, inner iter.Seq[int]) {
	q := db.Where("x")
	for a := range outer {
		for b := range inner {
			q = q.Where("a = ? AND b = ?", a, b)
		}
	}
	q.Find(nil)
}

// rangeFuncReassignHelper: a user function result assigned back to the same
// variable is a self-update too.
func rangeFuncReassignHelper(db *gorm.DB, seq iter.Seq[int]) {
	q := db.Where("x")
	for v := range seq {
		q = rangeFuncFilter(q, v)
	}
	q.Find(nil)
}

// rangeFuncStoreFreshValues: values that do not derive from an outer root
// may be stored into a captured variable on every iteration.
func rangeFuncStoreFreshValues(seq iter.Seq[int]) {
	var last *gorm.DB
	for v := range seq {
		last = rangeFuncNew()
		last = rangeFuncFromInt(v)
		last = rangeFuncFilter(rangeFuncNew(), v)
	}
	last.Find(nil)
}

func rangeFuncNew() *gorm.DB {
	return (*gorm.DB)(nil).Session(&gorm.Session{})
}

func rangeFuncFromInt(v int) *gorm.DB {
	return rangeFuncNew().Limit(v).Session(&gorm.Session{})
}

func rangeFuncFilter(q *gorm.DB, v int) *gorm.DB {
	return q.Where("v = ?", v)
}

// rangeFuncPlainClosure: a closure passed to a function that is not a range
// body is not assumed to run repeatedly.
func rangeFuncPlainClosure(db *gorm.DB, run func(func())) {
	q := db.Where("x")
	run(func() {
		q.Find(nil)
	})
}

// =============================================================================
// STORES IN THE BODY (#341)
//
// A store in a range-over-func body runs before the loop statement ends, so a
// read after the loop sees it, as it sees the loop-header Phi of a plain loop.
// The body may run no time, so the value before the loop is seen too.
// =============================================================================

// rangeFuncBodyStoreReused is #341: the Where stored in the body is queried
// twice after the loop. Before #341 the read saw only the WithContext.
func rangeFuncBodyStoreReused(ctx context.Context, db *gorm.DB, filters map[string]any) {
	q := db.WithContext(ctx)
	for k, v := range maps.All(filters) {
		q = q.Where(k+" = ?", v).Session(&gorm.Session{})
	}
	q.Count(nil)
	q.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
}

// rangeFuncBodyStoreBreak: a break leaves the body after some iterations.
func rangeFuncBodyStoreBreak(db *gorm.DB, seq iter.Seq2[string, any]) {
	q := db.Session(&gorm.Session{})
	for k, v := range seq {
		if k == "" {
			break
		}
		q = q.Where(k, v).Session(&gorm.Session{})
	}
	q.Find(nil)
	q.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
}

// rangeFuncBodyStoreNested: the store is in a loop nested in the body.
func rangeFuncBodyStoreNested(db *gorm.DB, outer iter.Seq[int], inner iter.Seq2[string, any]) {
	q := db.Session(&gorm.Session{})
	for range outer {
		for k, v := range inner {
			q = q.Where(k, v).Session(&gorm.Session{})
		}
	}
	q.Find(nil)
	q.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
}

type rangeFuncHolder struct{ db *gorm.DB }

// rangeFuncBodyStoreField: the body rebuilds a field of a local struct.
func rangeFuncBodyStoreField(db *gorm.DB, seq iter.Seq2[string, any]) {
	h := &rangeFuncHolder{db: db.Session(&gorm.Session{})}
	for k, v := range seq {
		h.db = h.db.Where(k, v).Session(&gorm.Session{})
	}
	h.db.Find(nil)
	h.db.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
}

// rangeFuncBodyStoreSpawned: a goroutine started after the loop reads the
// body's store too.
func rangeFuncBodyStoreSpawned(db *gorm.DB, seq iter.Seq2[string, any]) {
	q := db.Session(&gorm.Session{})
	for k, v := range seq {
		q = q.Where(k, v).Session(&gorm.Session{})
	}
	q.Find(nil)
	go func() {
		q.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
	}()
}

// rangeFuncBodyStoreOnce: one query after the loop.
func rangeFuncBodyStoreOnce(ctx context.Context, db *gorm.DB, filters map[string]any) {
	q := db.WithContext(ctx)
	for k, v := range maps.All(filters) {
		q = q.Where(k+" = ?", v)
	}
	q.Find(nil)
}

// rangeFuncBodyStoreReadInBody: a read in the body does not see the body's
// own store, so the query in the body is not a second branch of the Where
// before it.
func rangeFuncBodyStoreReadInBody(db *gorm.DB, seq iter.Seq2[string, any]) {
	q := db.Session(&gorm.Session{})
	for k, v := range seq {
		q = q.Where(k, v)
		q.Find(nil)
	}
}

// rangeFuncBodyStoreAfterLoop: the body runs only while its loop statement
// does, so it does not see a store made after the loop (#341). Before, it read
// the Where("late") and reported the body's query on every iteration.
func rangeFuncBodyStoreAfterLoop(db *gorm.DB, seq iter.Seq[string]) {
	q := db.Session(&gorm.Session{})
	for k := range seq {
		q.Where(k).Find(nil)
	}
	q = db.Where("late")
	q.Find(nil)
}

// rangeFuncSpawnedStoreAfterLoop: a goroutine started in the body may run
// after the loop, so it sees the store made after it.
func rangeFuncSpawnedStoreAfterLoop(db *gorm.DB, seq iter.Seq[string]) {
	q := db.Session(&gorm.Session{})
	for k := range seq {
		go func() {
			q.Where(k).Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
		}()
	}
	q = db.Where("late").Session(&gorm.Session{})
	q.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
}

var rangeFuncGlobal *gorm.DB

// rangeFuncBodyStoreGlobal: the body rebuilds a package-level variable.
func rangeFuncBodyStoreGlobal(seq iter.Seq2[string, any]) {
	for k, v := range seq {
		rangeFuncGlobal = rangeFuncGlobal.Where(k, v).Session(&gorm.Session{})
	}
	rangeFuncGlobal.Find(nil)
	rangeFuncGlobal.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
}

// rangeFuncBodyStoreSpawnedBefore: a goroutine started before the loops may
// run after them, so it sees the store of the nested body.
func rangeFuncBodyStoreSpawnedBefore(db *gorm.DB, outer iter.Seq[int], inner iter.Seq2[string, any]) {
	q := db.Session(&gorm.Session{})
	go func() {
		q.Find(nil)
	}()
	for range outer {
		for k, v := range inner {
			q = q.Where(k, v).Session(&gorm.Session{})
		}
	}
	q.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
}

// rangeFuncBodyStoreAfterIf: the loop starts in the block after an if, so
// what the if stored is seen with the body's store.
func rangeFuncBodyStoreAfterIf(db *gorm.DB, c bool, seq iter.Seq2[string, any]) {
	q := db.Session(&gorm.Session{})
	if c {
		q = db.Session(&gorm.Session{}).Where("c").Session(&gorm.Session{})
	}
	for k, v := range seq {
		q = q.Where(k, v)
	}
	q.Find(nil)
	q.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
}

// rangeFuncSeqOfDBRoot: a *gorm.DB range variable is a mutable root. The
// report names the range variable, not the declaration of iter.Seq (#378).
func rangeFuncSeqOfDBRoot(s iter.Seq[*gorm.DB]) {
	for d := range s {
		d.Find(nil)
		d.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root \(root at range_func\.go:390, first branch at range_func\.go:391\)`
	}
}

// rangeFuncSeq2ValueRoot: the value variable of a two-variable loop.
func rangeFuncSeq2ValueRoot(s iter.Seq2[int, *gorm.DB]) {
	for _, d := range s {
		d.Find(nil)
		d.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root \(root at range_func\.go:398, first branch at range_func\.go:399\)`
	}
}

// rangeFuncPlainFuncRoot: a plain func type names the range variable too.
func rangeFuncPlainFuncRoot(s func(func(*gorm.DB) bool)) {
	for d := range s {
		d.Find(nil)
		d.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root \(root at range_func\.go:406, first branch at range_func\.go:407\)`
	}
}
