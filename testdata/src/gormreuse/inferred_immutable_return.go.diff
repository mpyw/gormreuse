 // [LIMITATION] notInferredRecursive is immutable on every path that returns,
 // but inference only adds a function once its body is proved without it, so
 // a function that returns its own result is never inferred. Mark it
 // //gormreuse:immutable-return.
 func notInferredRecursive(db *gorm.DB, n int) *gorm.DB {
 	if n > 0 {
 		return notInferredRecursive(db, n-1)
 	}
 	return db.Session(&gorm.Session{})
 }
 
 func notInferredRecursiveUse(db *gorm.DB) {
-	q := notInferredRecursive(db, 3)
+	q := notInferredRecursive(db, 3).Session(&gorm.Session{})
 	q.Find(nil)
 	q.Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
 }
 
 // inferredCommaOk returns its parameter asserted to *gorm.DB, which holds
 // what the caller passes (#342): a call is as immutable as its argument.
 func inferredCommaOk(v any) *gorm.DB {
