 func sitePhiReassigned(db *gorm.DB, c, d bool) {
 	db = db.Session(&gorm.Session{})
 	a := db.Where("a")
 	b := db.Where("b")
 	q := b
 	if c {
 		q = a
 	}
 	if d {
 		q = q.Where("c")
 	}
 	q.Find(nil) // OK: q.Where("c") reassigns q
 }
