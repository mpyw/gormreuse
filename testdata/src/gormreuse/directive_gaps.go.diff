 // --- pure contract through an unmarked variadic callee ---
 
 func dgLogVariadic(msg string, args ...any) { fmt.Println(msg, args) }
 
 func dgLogOne(arg any) { fmt.Println(arg) }
 
 //gormreuse:pure
 func dgPureLogsVariadic(db *gorm.DB) {
 	dgLogVariadic("x", db) // want `pure function passes \*gorm\.DB argument to non-pure function`
 }
 
 //gormreuse:pure
 func dgPureLogsOne(db *gorm.DB) {
 	dgLogOne(db) // want `pure function passes \*gorm\.DB argument to non-pure function`
 }
 
 var dgSink []any
 
 func dgTakeSlice([]any) {}
 
 func dgTakeArray(*[1]any) {}
 
 // The slices and arrays below are not only a call's variadic arguments, so
 // storing db in them is a leak.
 
 //gormreuse:pure
 func dgPureSliceStored(db *gorm.DB) {
 	s := []any{db} // want `pure function leaks \*gorm\.DB argument via slice/array store`
 	dgSink = s
 }
 
 //gormreuse:pure
 func dgPureSlicePassed(db *gorm.DB) {
 	dgTakeSlice([]any{db}) // want `pure function leaks \*gorm\.DB argument via slice/array store`
 }
 
 //gormreuse:pure
 func dgPureArrayRead(db *gorm.DB) {
 	var a [1]any
 	a[0] = db // want `pure function leaks \*gorm\.DB argument via slice/array store`
 	dgLogVariadic("x", a[:]...)
 	_ = a[0]
 }
 
 //gormreuse:pure
 func dgPureArrayPassed(db *gorm.DB) {
 	var a [1]any
 	a[0] = db // want `pure function leaks \*gorm\.DB argument via slice/array store`
 	dgTakeArray(&a)
 }
 
 //gormreuse:pure
 func dgPureArrayKept(db *gorm.DB) {
 	var a [1]any
 	a[0] = db // want `pure function leaks \*gorm\.DB argument via slice/array store`
