 // --- immutable-return with a deferred fix held in a local ---
 
 // dgDeferHeldFix defers the closure through a local that another closure
 // captures, so SSA reads the closure back from the local.
 //
 //gormreuse:immutable-return
 func dgDeferHeldFix() (r *gorm.DB) {
 	r = irbDB.Where("x")
 	fix := func() { r = r.Session(&gorm.Session{}) }
 	dgKeep(func() { _ = fix })
 	defer fix()
 	return
 }
 
 // dgDeferHeldNoFix defers a closure that only reads the result.
 //
 //gormreuse:immutable-return
 func dgDeferHeldNoFix() (r *gorm.DB) { // want `immutable-return declared but function returns mutable \*gorm\.DB`
 	r = irbDB.Where("x")
 	read := func() { _ = r.Error }
 	dgKeep(func() { _ = read })
 	defer read()
 	return
 }
 
 func dgKeep(func()) {}
 
 // --- pure and immutable-param, with the pure check failing ---
 
 // dgPureFailsParam breaks its pure contract by branching db, so the pure
 // directive does not stand in for immutable-param: callers must still pass an
 // immutable value.
 //
 //gormreuse:pure
 //gormreuse:immutable-param
 func dgPureFailsParam(db *gorm.DB) {
 	db.Where("a").Find(nil) // want `pure function pollutes \*gorm\.DB argument by calling Where` `pure function pollutes \*gorm\.DB argument by calling Find`
 	db.Where("b").Find(nil) // want `pure function pollutes \*gorm\.DB argument by calling Where` `pure function pollutes \*gorm\.DB argument by calling Find`
 }
 
 func dgUsePureFailsParam(db *gorm.DB) {
 	q := db.Where("x")
-	dgPureFailsParam(q) // want `mutable \*gorm\.DB passed to dgPureFailsParam, which has a gormreuse:immutable-param directive`
+	dgPureFailsParam(q.Session(&gorm.Session{})) // want `mutable \*gorm\.DB passed to dgPureFailsParam, which has a gormreuse:immutable-param directive`
 }
