 // --- immutable-param on a Connection callback ---
 
 // dgConnectionCallback is handed to Connection, which passes it a mid-chain
 // (clone==0) handle, so immutable-param cannot exempt its parameter: the
 // second query also gets the first condition, as for a Scopes callback.
 //
 //gormreuse:immutable-param
 func dgConnectionCallback(tx *gorm.DB) error {
+	tx = tx.Session(&gorm.Session{})
 	tx.Where("a = 1").Find(nil)
 	tx.Where("b = 2").Find(nil) // want `\*gorm\.DB reused: second branch from mutable root`
 	return nil
 }
 
 func dgUseConnectionCallback(db *gorm.DB) {
 	_ = db.Connection(dgConnectionCallback)
 }
 
 // dgConnectionCallbackVar is handed to Connection through a local variable.
 //
 //gormreuse:immutable-param
 func dgConnectionCallbackVar(tx *gorm.DB) error {
+	tx = tx.Session(&gorm.Session{})
 	tx.Find(nil)
 	tx.Count(nil) // want `\*gorm\.DB reused: second branch from mutable root`
 	return nil
 }
 
 func dgUseConnectionCallbackVar(db *gorm.DB, cond bool) {
 	cb := dgConnectionCallback
 	if cond {
 		cb = dgConnectionCallbackVar
 	}
 	_ = db.Connection(cb)
 }
 
 // dgImmutableParamOK is not a Connection callback, so immutable-param still
 // exempts its parameter.
 //
 //gormreuse:immutable-param
 func dgImmutableParamOK(tx *gorm.DB) error {
 	tx.Find(nil)
 	tx.Count(nil) // OK: the callers pass an immutable value
 	return nil
 }
 
 func dgUseImmutableParamOK(db *gorm.DB) {
 	_ = dgImmutableParamOK(db.Session(&gorm.Session{}))
 }
 
 // --- immutable-input on a method declared through an alias receiver ---
 
 type dgRepo struct{ db *gorm.DB }
 
 type dgRepoAlias = dgRepo
 
 //gormreuse:immutable-input(cb)
 func (r *dgRepoAlias) With(cb func(*gorm.DB) error) error { // want With:`gormreuse immutable-input\(cb\)`
 	return cb(r.db.Session(&gorm.Session{}))
 }
 
 //gormreuse:immutable-input(cb)
 func (r *dgRepoAlias) WithBad(cb func(*gorm.DB) error) error {
 	return cb(r.db.Where("x")) // want `immutable-input\(cb\) declared but mutable \*gorm\.DB passed to callback`
 }
 
 func dgUseAliasReceiver(r *dgRepo) {
 	_ = r.With(func(tx *gorm.DB) error {
 		tx.Find(nil)
 		tx.Count(nil) // OK: With declares cb immutable-input
 		return nil
 	})
 }
 
